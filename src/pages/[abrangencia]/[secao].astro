---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { mandatos } from '../../lib/mandatos';
import type { Mandato } from '../../lib/schemas';
import { rotuloFase, secoes, type Secao } from '../../lib/secoes';

// Páginas provisórias das seções que ainda não foram construídas, em cada painel.
// Quando uma seção ficar pronta, ela ganha a sua própria página e sai desta lista.
export const getStaticPaths = (() =>
  mandatos.flatMap((mandato) =>
    secoes
      .filter((secao) => !secao.pronta)
      .map((secao) => ({
        params: { abrangencia: mandato.abrangencia, secao: secao.slug },
        props: { mandato, secao },
      })),
  )) satisfies GetStaticPaths;

interface Props {
  mandato: Mandato;
  secao: Secao;
}

const { mandato, secao } = Astro.props;
---

<Base
  titulo={`${secao.titulo} · ${mandato.nomeAbrangencia} | Painel dos Mandatos`}
  painel={mandato}
>
  <h1>{secao.titulo}</h1>
  <p>
    Esta seção do painel {mandato.nomeAbrangencia} está em construção e entra na {rotuloFase(secao)}
    do projeto.
  </p>
</Base>
