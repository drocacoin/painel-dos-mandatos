{
  "name": "painel-dos-mandatos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Painel público e apartidário de acompanhamento dos mandatos do presidente da República e do governador de São Paulo (2027–2031).",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "test": "vitest run",
    "coletar": "node --env-file-if-exists=.env scripts/coletar.ts",
    "rascunho": "node scripts/rascunho-promessas.ts"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "chart.js": "^4.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.3"
  }
}
